// ============================================
// CODEMPRESS - Complete Database Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// AUTH & USER
// ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Profile
  role            UserRole @default(USER)
  currentRole     String? // e.g., "Frontend Developer"
  targetRole      String? // e.g., "Full Stack Developer"
  experienceYears Int?
  learningStyle   String? // visual, auditory, kinesthetic
  bio             String?

  // Gamification
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?
  notificationPrefs Json?  // { achievements, careerUpdates, streakReminders }

  // Relations
  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  skills        UserSkill[]
  enrollments   Enrollment[]
  progress      UserProgress[]
  roadmaps      UserRoadmap[]
  chatMessages  ChatMessage[]
  badges        UserBadge[]
  projects      Project[]
  snippets      CodeSnippet[]
  notifications Notification[]
  quizAttempts  QuizAttempt[]
  topicProgress TopicProgress[]
  applications  JobApplication[]
  interviews    Interview[]
  emailTokens   EmailVerificationToken[]
  resetTokens   PasswordResetToken[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────
// RESUME & AI ANALYSIS
// ──────────────────────────────────────────

model Resume {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  fileUrl     String
  rawText     String?  @db.Text

  // AI Analysis Results
  score         Int?
  strengths     Json? // ["Strong React experience", ...]
  weaknesses    Json? // ["Missing backend skills", ...]
  suggestions   Json? // ["Add TypeScript", ...]
  missingSkills Json? // ["Docker", "AWS", ...]
  atsScore      Int?
  analysisRaw   Json? // Full AI response

  isActive    Boolean @default(true)

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ──────────────────────────────────────────
// SKILLS & KNOWLEDGE GRAPH
// ──────────────────────────────────────────

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String // "frontend", "backend", "devops", etc.
  description String?
  icon        String?

  userSkills    UserSkill[]
  prerequisites SkillPrerequisite[] @relation("prerequisite")
  dependents    SkillPrerequisite[] @relation("dependent")
  roadmapTopics RoadmapTopic[]
  courseSkills  CourseSkill[]

  createdAt DateTime @default(now())
}

model UserSkill {
  id         String     @id @default(cuid())
  userId     String
  skillId    String
  level      SkillLevel @default(NOT_STARTED)
  confidence Int        @default(0) // 0-100
  xpEarned   Int        @default(0)

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  lastUpdatedAt DateTime @default(now())

  @@unique([userId, skillId])
}

enum SkillLevel {
  NOT_STARTED
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MASTERED
}

model SkillPrerequisite {
  prerequisiteId String
  dependentId    String

  prerequisite Skill @relation("prerequisite", fields: [prerequisiteId], references: [id])
  dependent    Skill @relation("dependent", fields: [dependentId], references: [id])

  @@id([prerequisiteId, dependentId])
}

// ──────────────────────────────────────────
// COURSES & CONTENT
// ──────────────────────────────────────────

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @db.Text
  thumbnail   String?
  category    String
  level       CourseLevel  @default(BEGINNER)
  duration    Int? // in minutes
  isPublished Boolean      @default(false)
  isFree      Boolean      @default(true)
  sourceUrl   String? // Link to external resource
  sourceType  String? // "youtube", "internal", "external"
  order       Int          @default(0)

  modules     Module[]
  enrollments Enrollment[]
  skills      CourseSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  duration  Int?

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics  Topic[]

  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────
// ARCANE LIBRARY (see docs/PRODUCT_SPEC.md)
// Subject = a curriculum category (the 28 subjects).
// A Topic may belong to a Subject (curriculum) and/or a
// Module (content-production hierarchy). Curriculum
// topics carry XP reward, difficulty rating, and a
// sequence index used for sequential unlocking.
// ──────────────────────────────────────────

model Subject {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  description String?
  icon        String?
  order       Int     @default(0)

  topics Topic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────
// CONTENT PRODUCTION (see docs/CONTENT_GUIDE.md)
// Topic sits between Module and Lesson; each topic
// carries the guide's metadata + review status.
// ──────────────────────────────────────────

model Topic {
  id            String         @id @default(cuid())
  subjectId     String?
  moduleId      String?
  title         String
  slug          String         @unique
  summary       String?        @db.Text
  description   String?        @db.Text

  // Curriculum (Arcane Library / gamification)
  xpReward        Int    @default(50)
  difficultyRating Float @default(1.0)
  sequence        Int    @default(0)
  isLockedDefault Boolean @default(false)
  theory          String? @db.Text

  // Metadata schema (guide §4)
  difficulty    TopicDifficulty @default(BEGINNER)
  estimatedTime Int? // in minutes
  tags          String[]
  prerequisites String         @default("")
  careerPaths   String         @default("[]") // JSON array string

  // Review workflow (guide §12) + versioning (guide §13)
  contentStatus  TopicStatus    @default(DRAFT)
  version        String         @default("0.1.0")
  lastReviewedAt DateTime?

  order         Int            @default(0)
  isPublished   Boolean        @default(false)

  subject Subject?  @relation(fields: [subjectId], references: [id])
  module  Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lessons Lesson[]

  quizzes      Quiz[]
  topicProgress TopicProgress[]
  roadmapTopics RoadmapTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TopicDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TopicStatus {
  DRAFT
  AI_REVIEW
  TECH_REVIEW
  EDITORIAL_REVIEW
  QA
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id        String       @id @default(cuid())
  topicId   String
  title     String
  slug      String
  content   String?      @db.Text
  videoUrl  String?
  type      LessonType   @default(VIDEO)
  duration  Int? // in minutes
  order     Int
  isFree    Boolean      @default(true)

  topic    Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress UserProgress[]
  quizzes  Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LessonType {
  VIDEO
  TEXT
  INTERACTIVE
  QUIZ
  PROJECT
}

model CourseSkill {
  courseId String
  skillId  String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
}

// ──────────────────────────────────────────
// ENROLLMENT & PROGRESS
// ──────────────────────────────────────────

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  status    EnrollmentStatus @default(ACTIVE)
  progress  Int              @default(0) // 0-100

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  DROPPED
}

model UserProgress {
  id        String         @id @default(cuid())
  userId    String
  lessonId  String
  status    ProgressStatus @default(NOT_STARTED)
  score     Int?
  timeSpent Int? // in seconds
  attempts  Int            @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  startedAt   DateTime?
  completedAt DateTime?

  @@unique([userId, lessonId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}

// Topic-scoped progress for the Arcane Library gamification loop.
model TopicProgress {
  id            String    @id @default(cuid())
  userId        String
  topicId       String
  theoryRead    Boolean   @default(false)
  theoryCompletedAt DateTime?
  quizAttempts  Int       @default(0)
  quizCorrect   Int       @default(0)
  quizCompleted Boolean   @default(false)
  masteryPercent Float    @default(0)
  lastAccessed  DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

// ──────────────────────────────────────────
// ROADMAPS
// ──────────────────────────────────────────

model Roadmap {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  targetRole  String // "Full Stack Developer", "DevOps Engineer"
  icon        String?
  isPrebuilt  Boolean  @default(true)
  isPublished Boolean  @default(false)
  order       Int      @default(0)

  levels      RoadmapLevel[]
  userRoadmaps UserRoadmap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoadmapLevel {
  id        String   @id @default(cuid())
  roadmapId String
  name      String // "Beginner", "Intermediate", "Advanced"
  order     Int

  roadmap Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics  RoadmapTopic[]
}

model RoadmapTopic {
  id          String   @id @default(cuid())
  levelId     String
  skillId     String?
  topicId     String? // Optional link to a library Topic (PRD: roadmap ↔ course)
  title       String
  description String?
  order       Int
  isRequired  Boolean  @default(true)

  level     RoadmapLevel    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  skill     Skill?          @relation(fields: [skillId], references: [id])
  topic     Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopics RoadmapSubtopic[]
}

model RoadmapSubtopic {
  id      String @id @default(cuid())
  topicId String
  title   String
  order   Int

  topic RoadmapTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model UserRoadmap {
  id            String   @id @default(cuid())
  userId        String
  roadmapId     String? // null if fully custom
  name          String
  isAiGenerated Boolean  @default(false)
  progress      Int      @default(0)
  data          Json? // Custom roadmap structure

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap? @relation(fields: [roadmapId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────
// AI MENTOR & CHAT
// ──────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String   @db.Text
  context   Json? // What context was used
  tokens    Int?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// ──────────────────────────────────────────
// QUIZZES & ASSESSMENTS
// ──────────────────────────────────────────

model Quiz {
  id           String   @id @default(cuid())
  lessonId     String?
  topicId      String?
  title        String
  type         QuizType @default(MULTIPLE_CHOICE)
  passingScore Int      @default(70)

  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  topic     Topic?        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
}

enum QuizType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  CODE_CHALLENGE
  FILL_BLANK
}

model Question {
  id             String  @id @default(cuid())
  quizId         String
  text           String  @db.Text
  options        Json? // For MCQ: [{text, isCorrect}]
  correctAnswer  String?
  explanation    String? @db.Text
  points         Int     @default(10)
  order          Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  totalPoints Int
  passed      Boolean
  answers     Json // User's answers

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  attemptedAt DateTime @default(now())
}

// ──────────────────────────────────────────
// GAMIFICATION
// ──────────────────────────────────────────

model Badge {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String
  icon        String
  category    BadgeCategory
  requirement String? // "Complete 5 courses"
  xpReward    Int           @default(0)
  rarity      BadgeRarity   @default(COMMON)

  userBadges UserBadge[]
}

enum BadgeCategory {
  LEARNING
  STREAK
  ACHIEVEMENT
  SOCIAL
  SPECIAL
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model UserBadge {
  id      String @id @default(cuid())
  userId  String
  badgeId String

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// ──────────────────────────────────────────
// PROJECTS & PORTFOLIO
// ──────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?       @db.Text
  githubUrl   String?
  liveUrl     String?
  thumbnail   String?
  techStack   Json? // ["React", "Node.js"]
  status      ProjectStatus @default(IN_PROGRESS)
  aiFeedback  String?       @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  REVIEWED
  FEATURED
}

// ──────────────────────────────────────────
// CAREER HUB (Module 8)
// ──────────────────────────────────────────

model JobApplication {
  id              String            @id @default(cuid())
  userId          String
  company         String
  position        String
  status          ApplicationStatus @default(APPLIED)
  location        String?
  salaryRange     String?
  jobUrl          String?
  notes           String?           @db.Text
  appliedAt       DateTime          @default(now())
  lastUpdatedAt   DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews      Interview[]

  createdAt       DateTime          @default(now())
}

enum ApplicationStatus {
  APPLIED
  PHONE_SCREEN
  TECHNICAL
  ONSITE
  OFFER
  REJECTED
  WITHDRAWN
}

model Interview {
  id            String   @id @default(cuid())
  applicationId String
  userId        String
  type          String // phone_screen | technical | onsite | behavioral | system_design
  scheduledAt   DateTime?
  durationMin   Int?
  score         Int?
  feedback      String?  @db.Text
  notes         String?  @db.Text

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

// ──────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────

model Notification {
  id      String           @id @default(cuid())
  userId  String
  title   String
  message String
  type    NotificationType
  link    String?
  isRead  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NotificationType {
  ACHIEVEMENT
  COURSE_UPDATE
  ROADMAP_READY
  STREAK_REMINDER
  AI_INSIGHT
  SYSTEM
}

// ──────────────────────────────────────────
// CODE FORGE SNIPPETS (Playground save-project)
// ──────────────────────────────────────────

model CodeSnippet {
  id        String   @id @default(cuid())
  userId    String
  lang      String // javascript | python
  name      String
  code      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

// ──────────────────────────────────────────
// EMAIL VERIFICATION & PASSWORD RESET (Auth)
// ──────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────
// SANDBOX MAILBOX (in-app email for testing without SMTP)
// ──────────────────────────────────────────

model Mail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String   @db.Text
  html      String   @db.Text
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}
